#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["numpy", "scipy", "pyloudnorm"]
# ///
"""sfx-mix: lay sound effects on a timeline, mix them with the music and mux into a rendered video.

    bin/sfx-mix src/scenes/dungeon.sfx.json --video=out/dungeon.mp4 --out=out/dungeon_sfx.mp4
    bin/sfx-mix src/scenes/dungeon.sfx.json --wav=out/check/mix.wav          audio only, for checking
    bin/sfx-mix src/scenes/x.sfx.json --still=assets/x.jpg --out=out/x.mp4    a still image as the picture
    bin/sfx-mix src/scenes/x.sfx.json --wav=out/check/x.wav --meter=2         loudness per bus every 2 s

The cue sheet (JSON):
    { "music": "assets/song.mp3", "music_gain": .7, "sfx_gain": .75, "duration": 31.5, "sfx_dir": "assets/sfx",
      "cues": [ cue, ... ] }
A cue places one sound at time t (seconds):
    { "t": 4.81, "src": "doorOpen_1.ogg", "gain": .8 }
  file options: gain, rate (playback speed: > 1 is higher and shorter, cartoon style), lowpass (Hz, e.g. muffled
                underwater), offset/dur (seconds into the file / length to keep), fade (fade-out seconds at the end)
  repeats:      "every": .19, "until": 1.95 (re-fire until that time); "src" may be a list, cycled per hit;
                "jitter": .1 varies rate and gain per hit so repeats don't sound copied
  synths:       "src": "synth:slide" (slide whistle, f0 → f1 Hz over dur), "synth:whoosh" (a noise band sweeping
                f0 → f1), "synth:bubbles" (dense little bubble blips, rate = bubbles/s), "synth:tweet"
                (birdie chirps, rate = chirps/s), "synth:hum" (a rising buzzy charge-up, f0 → f1), "synth:rain" (a rain
                bed: hiss and droplets, different in each ear; rate = drops/s, attack = fade-in seconds), "synth:purr"
                (a cat's purr: a low rumble pulsing rate times a second, breath = seconds per breath)
  more:         fade_in (seconds), loop (repeat the file to fill dur), bus (a name, default "main"),
                level (dBFS: scale the sound so its loudest 50 ms has this RMS, before gain and space, so files
                recorded at different levels mix by number),
                space (a named entry of "spaces", or an inline chain); a src that starts with "./" is a path from
                the repo root (a song in private/, say), any other src is in sfx_dir
Spaces put a sound somewhere: far down a corridor, behind a door, in another room. A space is a chain of steps,
applied in order, each a dict:
    {"mono": true}                                fold to mono first (a distant source is a point)
    {"lowpass": 700, "order": 2}                  Butterworth; each order is 6 dB/octave (a wall, a closed door)
    {"highpass": 120, "order": 2}
    {"ir": "assets/ir/x.wav", "wet": 1, "dry": 0, "direct": .3, "predelay": .02}
                                                  convolve with a measured impulse response (unit energy). "ir"
                                                  may be a list, convolved in series (a room, then a corridor).
                                                  direct scales the IR's first 5 ms, the direct path: < 1 = farther
    {"gain": .5} or {"db": -6}, {"swap": true} (left and right), {"delay": .03}
    "spaces": { "far": [ step, ... ], ... }
Buses change over time, for a door that slams shut between the listener and everything on that bus:
    "buses": { "far": [ {"t": 69.1, "ramp": .12, "chain": [ {"lowpass": 300, "order": 2}, {"db": -8} ]} ] }
After t (crossfaded over ramp seconds) the bus is heard through that chain; a later event replaces an earlier one.
"loudness": -18 sets the integrated loudness (ITU-R BS.1770, LUFS) of the mix before the soft limiter.
Sounds are resampled to 48 kHz stereo by ffmpeg; the sum is soft-limited so stacked hits don't clip.
"""
import argparse
import json
import subprocess
import sys
from pathlib import Path

import numpy as np

SR = 48000
ROOT = Path(__file__).resolve().parent.parent


def decode(path, rate=1.0, lowpass=None, offset=0.0, dur=None, loop=False):
    af = []
    if rate != 1.0:
        af += [f"asetrate={int(SR * rate)}", f"aresample={SR}"]
    if lowpass:
        af.append(f"lowpass=f={lowpass}")
    if loop and not dur:
        sys.exit(f"loop needs dur: {path}")
    cmd = ["ffmpeg", "-v", "error"] + (["-stream_loop", "-1"] if loop else []) + ["-ss", str(offset)]
    cmd += (["-t", str(dur * rate)] if dur else []) + ["-i", str(path)]
    cmd += (["-af", ",".join(af)] if af else []) + ["-f", "f32le", "-ac", "2", "-ar", str(SR), "-"]
    raw = subprocess.run(cmd, capture_output=True, check=True).stdout
    return np.frombuffer(raw, dtype=np.float32).reshape(-1, 2).copy()


_IRS = {}


def load_ir(path):
    """A measured impulse response at 48 kHz stereo, from its onset, scaled to unit energy per channel."""
    p = Path(path) if Path(path).is_absolute() else ROOT / path
    if p not in _IRS:
        ir = decode(p)
        mag = np.abs(ir).max(axis=1)
        on = int(np.argmax(mag > .1 * mag.max()))
        ir = ir[max(0, on - SR // 1000):].astype(np.float64)
        ir /= np.sqrt((ir ** 2).sum(axis=0).mean())
        _IRS[p] = ir
    return _IRS[p]


def convolve(y, ir):
    from scipy.signal import oaconvolve
    return np.stack([oaconvolve(y[:, ch], ir[:, ch]) for ch in range(2)], axis=1)


def pad(y, n):
    return np.vstack([y, np.zeros((n - len(y), 2))]) if n > len(y) else y


def place(y, chain):
    """Run a sound through a space: the chain of steps documented at the top."""
    from scipy.signal import butter, sosfilt
    y = y.astype(np.float64)
    for st in chain:
        if st.get("mono"):
            y = np.repeat(y.mean(axis=1, keepdims=True), 2, axis=1)
        if "highpass" in st:
            y = sosfilt(butter(st.get("order", 2), st["highpass"], "highpass", fs=SR, output="sos"), y, axis=0)
        if "lowpass" in st:
            y = sosfilt(butter(st.get("order", 2), st["lowpass"], "lowpass", fs=SR, output="sos"), y, axis=0)
        if "ir" in st:
            wet = y
            for path in st["ir"] if isinstance(st["ir"], list) else [st["ir"]]:
                ir = load_ir(path)
                if st.get("direct", 1) != 1:
                    ir = ir.copy(); ir[:int(.005 * SR)] *= st["direct"]
                wet = convolve(wet, ir)
            if st.get("predelay"):
                wet = np.vstack([np.zeros((int(st["predelay"] * SR), 2)), wet])
            n = max(len(wet), len(y))
            y = pad(wet, n) * st.get("wet", 1.0) + pad(y, n) * st.get("dry", 0.0)
        if "gain" in st:
            y = y * st["gain"]
        if "db" in st:
            y = y * 10 ** (st["db"] / 20)
        if st.get("swap"):
            y = y[:, ::-1]
        if st.get("delay"):
            y = np.vstack([np.zeros((int(st["delay"] * SR), 2)), y])
    return y.astype(np.float32)


def automate(bus, events):
    """Crossfade a bus into each event's chain at its time; a later event replaces an earlier one."""
    out = bus.copy()
    for ev in sorted(events, key=lambda e: e["t"]):
        wet = place(bus, ev["chain"])[:len(bus)]
        wet = pad(wet, len(bus)).astype(np.float32)
        s, r = int(ev["t"] * SR), max(1, int(ev.get("ramp", .05) * SR))
        m = np.clip((np.arange(len(bus)) - s) / r, 0, 1)[:, None]
        out = out * (1 - m) + wet * m
    return out


def env(n, attack=.01, release=.1):
    e = np.ones(n)
    a, r = min(n, int(attack * SR)), min(n, int(release * SR))
    if a: e[:a] = np.linspace(0, 1, a)
    if r: e[n - r:] *= np.linspace(1, 0, r)
    return e


def synth(kind, c, rng):
    dur = c.get("dur", 1.0)
    n = int(dur * SR)
    t = np.arange(n) / SR
    f0, f1 = c.get("f0", 800), c.get("f1", 200)
    if kind == "slide":   # slide whistle: an exponential glide with a little vibrato and breath
        f = f0 * (f1 / f0) ** (t / dur) * (1 + .012 * np.sin(2 * np.pi * 6 * t))
        y = np.sin(2 * np.pi * np.cumsum(f) / SR) + .08 * rng.standard_normal(n) * np.sin(2 * np.pi * np.cumsum(f) / SR) ** 2
        y *= env(n, .03, .15) * .5
    elif kind == "whoosh":   # a band of noise sweeping f0 → f1, built in the STFT domain
        hop, win = 512, 2048
        frames = n // hop + 1
        freqs = np.fft.rfftfreq(win, 1 / SR)
        out = np.zeros(n + win)
        w = np.hanning(win)
        for i in range(frames):
            k = i / max(1, frames - 1)
            fc = f0 * (f1 / f0) ** k
            mag = np.exp(-.5 * ((np.log(freqs + 1) - np.log(fc)) / c.get("width", .45)) ** 2)
            spec = mag * np.exp(2j * np.pi * rng.random(len(freqs)))
            out[i * hop:i * hop + win] += np.fft.irfft(spec) * w
        y = out[:n]
        y = y / (np.abs(y).max() + 1e-9) * np.sin(np.pi * np.clip(t / dur, 0, 1)) ** 1.5 * .6
    elif kind == "bubbles":   # Minnaert-style bubbles: short decaying sine chirps that rise in pitch
        y = np.zeros(n)
        for _ in range(int(c.get("rate", 12) * dur)):
            s = int(rng.random() * n)
            fb = rng.uniform(f1, f0)
            L = int(.06 * SR)
            tt = np.arange(L) / SR
            b = np.sin(2 * np.pi * fb * (tt + 6 * tt * tt)) * np.exp(-tt / .018) * rng.uniform(.3, 1)
            e = min(n, s + L); y[s:e] += b[:e - s]
        y *= .35
    elif kind == "tweet":   # birdie chirps circling a dizzy head: fast upward sine sweeps in pairs
        y = np.zeros(n)
        for i in range(int(c.get("rate", 4) * dur)):
            s = int((i / c.get("rate", 4) + rng.uniform(0, .05)) * SR)
            for j in range(2):
                L = int(.07 * SR); tt = np.arange(L) / SR
                fb = rng.uniform(f0, f1)
                ch = np.sin(2 * np.pi * (fb * tt + fb * 2.5 * tt * tt / .07)) * np.sin(np.pi * tt / .07)
                a = s + j * int(.09 * SR); e = min(n, a + L)
                if a < n: y[a:e] += ch[:e - a] * .3
    elif kind == "hum":   # a charge-up: buzzy harmonics rising f0 → f1 with a quickening tremolo
        f = f0 * (f1 / f0) ** (t / dur)
        ph = 2 * np.pi * np.cumsum(f) / SR
        y = sum(np.sin(h * ph) / h for h in range(1, 7))
        y *= (.6 + .4 * np.sin(2 * np.pi * (4 + 18 * t / dur) * t)) * (t / dur) ** .7 * env(n, .05, .05) * .35
    elif kind == "rain":   # a rain bed: band-limited hiss plus a patter of droplets, independent in each ear
        chans = []
        fr = np.fft.rfftfreq(n, 1 / SR)
        for ch in range(2):
            spec = np.fft.rfft(rng.standard_normal(n)) * np.exp(-.5 * ((np.log(fr + 1) - np.log(2600)) / .9) ** 2)
            hiss = np.fft.irfft(spec, n)
            hiss *= (1 + .15 * np.sin(2 * np.pi * (.13 + .07 * ch) * t + rng.uniform(0, 6))) / (np.abs(hiss).max() + 1e-9)
            drops = np.zeros(n)
            L = int(.02 * SR)
            tt = np.arange(L) / SR
            for _ in range(int(c.get("rate", 90) * dur)):
                s = int(rng.random() * n)
                d = np.sin(2 * np.pi * rng.uniform(1800, 6500) * tt) * np.exp(-tt / rng.uniform(.002, .008)) * rng.uniform(.2, 1)
                e = min(n, s + L); drops[s:e] += d[:e - s]
            chans.append((hiss * .5 + drops * .25) * env(n, c.get("attack", 2.0), .3) * .5)
        return np.stack(chans, axis=1).astype(np.float32)
    elif kind == "purr":   # a cat's purr: a low rumble pulsing about 25 times a second, rising and falling with each breath
        fr = np.fft.rfftfreq(n, 1 / SR)
        rumble = np.fft.irfft(np.fft.rfft(rng.standard_normal(n)) * np.exp(-.5 * ((fr - 140) / 70) ** 2), n)
        rumble /= np.abs(rumble).max() + 1e-9
        pulse = (.5 + .5 * np.sin(2 * np.pi * c.get("rate", 25) * t)) ** 2
        breath = .6 + .4 * np.sin(np.pi * t / c.get("breath", 1.8)) ** 2
        y = rumble * pulse * breath * env(n, .4, .6) * .6
    else:
        sys.exit(f"unknown synth: {kind}")
    return np.stack([y, y], axis=1).astype(np.float32)


def expand(cues):
    out = []
    for c in cues:
        srcs = c["src"] if isinstance(c["src"], list) else [c["src"]]
        if "every" in c:
            t, i = c["t"], 0
            while t <= c["until"] + 1e-9:
                out.append({**c, "t": round(t, 4), "src": srcs[i % len(srcs)], "_hit": i}); t += c["every"]; i += 1
        else:
            out.append({**c, "src": srcs[0], "_hit": 0})
    return out


def lufs(y):
    """Integrated loudness in LUFS (ITU-R BS.1770 with its gates); -inf for silence or under a second of audio."""
    import pyloudnorm
    return pyloudnorm.Meter(SR).integrated_loudness(y.astype(np.float64)) if len(y) > SR else float("-inf")


def mix(sheet, meter=None):
    dur = sheet["duration"]
    n = int(dur * SR) + SR
    buses = {}
    sfx_dir = ROOT / sheet.get("sfx_dir", "assets/sfx")
    spaces = sheet.get("spaces", {})
    rng = np.random.default_rng(sheet.get("seed", 7))
    for c in expand(sheet["cues"]):
        j = c.get("jitter", 0)
        rate = c.get("rate", 1.0) * (1 + j * rng.uniform(-1, 1)) if j else c.get("rate", 1.0)
        gain = c.get("gain", 1.0) * (1 + .5 * j * rng.uniform(-1, 1)) if j else c.get("gain", 1.0)
        if c["src"].startswith("synth:"):
            y = synth(c["src"][6:], c, rng)
            if c.get("lowpass"):   # muffle a synth the same way ffmpeg muffles a file
                y = np.frombuffer(subprocess.run(["ffmpeg", "-v", "error", "-f", "f32le", "-ar", str(SR), "-ac", "2", "-i", "-", "-af", f"lowpass=f={c['lowpass']}",
                                                  "-f", "f32le", "-ac", "2", "-ar", str(SR), "-"], input=y.tobytes(), capture_output=True, check=True).stdout, dtype=np.float32).reshape(-1, 2).copy()
        else:
            src = ROOT / c["src"] if c["src"].startswith("./") else sfx_dir / c["src"]
            y = decode(src, rate, c.get("lowpass"), c.get("offset", 0), c.get("dur"), c.get("loop", False))
        if c.get("level") is not None:
            w = int(.05 * SR)
            peak = max(np.sqrt((y[i:i + w] ** 2).mean()) for i in range(0, max(1, len(y) - w + 1), w // 2))
            y *= 10 ** (c["level"] / 20) / max(peak, 1e-9)
        if c.get("fade_in"):
            k = min(len(y), int(c["fade_in"] * SR)); y[:k] *= np.linspace(0, 1, k)[:, None]
        if c.get("fade"):
            k = min(len(y), int(c["fade"] * SR)); y[len(y) - k:] *= np.linspace(1, 0, k)[:, None]
        if c.get("space"):
            chain = spaces[c["space"]] if isinstance(c["space"], str) else c["space"]
            y = place(y, chain)
        bus = buses.setdefault(c.get("bus", "main"), np.zeros((n, 2), dtype=np.float32))
        s = int(c["t"] * SR); e = min(len(bus), s + len(y))
        bus[s:e] += y[:e - s] * gain
    total = np.zeros((n, 2), dtype=np.float32)
    for name, bus in buses.items():
        if name in sheet.get("buses", {}):
            bus = buses[name] = automate(bus, sheet["buses"][name])
        total += bus
    total *= sheet.get("sfx_gain", 1.0)
    sfx_peak = np.abs(total).max()
    if sheet.get("music"):
        m = decode(ROOT / sheet["music"]) * sheet.get("music_gain", .7)
        k = min(len(total), len(m)); total[:k] += m[:k]
    total = total[:int(dur * SR)]
    gain = 1.0
    if sheet.get("loudness") is not None:
        gain = 10 ** ((sheet["loudness"] - lufs(total)) / 20)
        total *= gain
    out = np.tanh(total * 1.1) / np.tanh(1.1) * .8   # soft limiter with a ceiling low enough that AAC's intersample peaks stay under 0 dBFS
    print(f"{len(expand(sheet['cues']))} sfx hits, sfx peak {sfx_peak:.2f}, mix peak {np.abs(total).max():.2f} before limiting"
          + (f", loudness gain {20 * np.log10(gain):+.1f} dB, out {lufs(out):.1f} LUFS" if gain != 1.0 else ""))
    if meter:
        names = sorted(buses)
        print("   t   " + "".join(f"{b[:10]:>11}" for b in names) + "        mix   (LUFS, 3 s windows)")
        w = int(3 * SR)
        for t in np.arange(0, dur, meter):
            i = int(t * SR)
            row = [lufs(buses[b][i:i + w] * sheet.get("sfx_gain", 1.0) * gain) for b in names] + [lufs(out[i:i + w])]
            print(f"{t:6.1f} " + "".join(f"{v:11.1f}" for v in row))
    return out.astype(np.float32)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("sheet", type=Path)
    ap.add_argument("--video", type=Path)
    ap.add_argument("--out", type=Path)
    ap.add_argument("--wav", type=Path)
    ap.add_argument("--still", type=Path, help="make the picture from this image (needs --out)")
    ap.add_argument("--meter", type=float, help="print the loudness of each bus every N seconds")
    a = ap.parse_args()
    if a.still and not a.out:
        sys.exit("--still needs --out")
    sheet = json.loads(a.sheet.read_text())
    audio = mix(sheet, a.meter)
    wav = a.wav or Path("out/check/_mix.f32")
    wav.parent.mkdir(parents=True, exist_ok=True)
    raw = wav.with_suffix(".f32"); audio.tofile(raw)
    if a.wav:
        subprocess.run(["ffmpeg", "-y", "-v", "error", "-f", "f32le", "-ar", str(SR), "-ac", "2", "-i", str(raw), str(a.wav)], check=True)
        print(f"wrote {a.wav}")
    if a.still:
        a.out.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ffmpeg", "-y", "-v", "error", "-loop", "1", "-framerate", "30", "-i", str(a.still),
                        "-f", "f32le", "-ar", str(SR), "-ac", "2", "-i", str(raw), "-map", "0:v", "-map", "1:a",
                        "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2,format=yuv420p", "-c:v", "libx264", "-tune", "stillimage",
                        "-crf", "20", "-g", "600", "-c:a", "aac", "-b:a", "192k", "-t", str(sheet["duration"]),
                        "-movflags", "+faststart", str(a.out)], check=True)   # -t, not -shortest: a looped image overshoots it
        print(f"wrote {a.out}")
    if a.video:
        out = a.out or a.video.with_name(a.video.stem + "_sfx.mp4")
        subprocess.run(["ffmpeg", "-y", "-v", "error", "-i", str(a.video), "-f", "f32le", "-ar", str(SR), "-ac", "2", "-i", str(raw),
                        "-map", "0:v", "-map", "1:a", "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", "-shortest", str(out)], check=True)
        print(f"wrote {out}")
    raw.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
